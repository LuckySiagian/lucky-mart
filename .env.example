# ==============================================================================
# Lucky Mart API configuration
# Copy to .env.development (local) or set these as environment variables on
# your hosting platform. Real environment variables override the file.
# ==============================================================================

# --- Application --------------------------------------------------------------
APP_NAME="LuckyMart API"
APP_ENV="development" # development, staging, production
APP_VERSION="1.0.0"

# --- Server -------------------------------------------------------------------
# Hosting platforms that set PORT (Render, Railway, Fly) override this.
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# --- Database (PostgreSQL) ----------------------------------------------------
# Either set DATABASE_URL (Neon / Supabase / Render style connection string)...
# DATABASE_URL=postgres://user:password@host:5432/sembako_db?sslmode=require
# ...or the individual fields below.
DATABASE_DB_HOST=localhost
DATABASE_DB_PORT=5433
DATABASE_DB_USER=postgres
DATABASE_DB_PASSWORD=postgres
DATABASE_DB_NAME=sembako_db
DATABASE_DB_SSLMODE=disable
DATABASE_DB_MAX_OPEN_CONNS=25
DATABASE_DB_MAX_IDLE_CONNS=10
DATABASE_DB_CONN_MAX_LIFETIME=15m

# --- JWT authentication -------------------------------------------------------
# In production both secrets are required: random, different, 32+ characters.
# Generate one with:  openssl rand -base64 48
JWT_JWT_ACCESS_SECRET=change-me-dev-access-secret-at-least-32-chars
JWT_JWT_REFRESH_SECRET=change-me-dev-refresh-secret-at-least-32-chars
JWT_JWT_ACCESS_TTL=15m
JWT_JWT_REFRESH_TTL=168h

# --- CORS ---------------------------------------------------------------------
# Comma-separated frontend URLs. "*" is only accepted outside production.
# Example: https://luckymart.vercel.app,https://admin-luckymart.vercel.app
CORS_ALLOW_ORIGINS=*

# --- First run ----------------------------------------------------------------
# Password for the Super Admin created on the very first start (phone
# 081234567890). Always set this outside local development.
SEED_ADMIN_PASSWORD=
