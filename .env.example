# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
APP_NAME="LuckyMart API"
APP_ENV="development" # development, staging, production
APP_VERSION="1.0.0"

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# ==============================================================================
# DATABASE CONFIGURATION (POSTGRESQL)
# ==============================================================================
DATABASE_DB_HOST=localhost
DATABASE_DB_PORT=5432
DATABASE_DB_USER=postgres
DATABASE_DB_PASSWORD=postgres
DATABASE_DB_NAME=sembako_db
DATABASE_DB_SSLMODE=disable
DATABASE_DB_MAX_OPEN_CONNS=25
DATABASE_DB_MAX_IDLE_CONNS=10
DATABASE_DB_CONN_MAX_LIFETIME=15m

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
JWT_JWT_ACCESS_SECRET=super-secret-access-token-key-change-this-in-production!
JWT_JWT_REFRESH_SECRET=super-secret-refresh-token-key-change-this-in-production!
JWT_JWT_ACCESS_TTL=15m
JWT_JWT_REFRESH_TTL=168h

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
CORS_ALLOW_ORIGINS=*
